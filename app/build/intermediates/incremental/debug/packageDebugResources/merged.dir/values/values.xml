    <string name="voice_commands_help">
        Voice Commands:\n
        • "Open [app name]" - Launch an app\n
        • "Call [number]" - Make a phone call\n
        • "WhatsApp [contact] [message]" - Send WhatsApp message\n
        • "Message [contact] [message]" - Send WhatsApp message\n
        • "Search [query]" - Search on Google\n
        • "Google [query]" - Search on Google\n
        • "Look up [query]" - Search on Google
